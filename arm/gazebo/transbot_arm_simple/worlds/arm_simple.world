<?xml version="1.0"?>
<!--
  Simplest arm-only world: no ground plane model, no wall, no props.
  Just the arm, a sun light, and an empty sky background.
-->
<sdf version="1.6">
  <world name="arm_simple">

    <gui fullscreen="0">
      <camera name="user_camera">
        <!-- Front-left three-quarter view of the arm. -->
        <pose>-0.35 -0.45 0.30 0 0.2323 0.6327</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>0.55 0.25 -0.80</direction>
    </light>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.78 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

  </world>
</sdf>
