Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
      Splitter Ratio: 0.45
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.8
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local costmap
      Topic: /move_base/local_costmap/costmap
      Unreliable: false
      Value: true
    - Class: rviz/LaserScan
      Color: 255; 70; 70
      Color Transformer: FlatColor
      Enabled: true
      Name: LaserScan
      Queue Size: 10
      Size (m): 0.03
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 40; 220; 60
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Global plan
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Style: None
      Radius: 0.03
      Topic: /move_base/GlobalPlanner/plan
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 60; 140; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Local plan
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Style: None
      Radius: 0.03
      Topic: /move_base/DWAPlannerROS/local_plan
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/PoseWithCovariance
      Color: 255; 200; 0
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 0
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 255; 255; 0
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Head Length: 0.15
      Head Radius: 0.08
      Name: AMCL pose
      Shaft Length: 0.2
      Shaft Radius: 0.04
      Shape: Arrow
      Topic: /amcl_pose
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Alpha: 1
      Buffer Length: 1
      Color: 255; 80; 80
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Goal
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Style: None
      Radius: 0.03
      Topic: /move_base/goal
      Unreliable: false
      Value: false
    - Class: rviz/Grid
      Cell Size: 1
      Color: 120; 120; 120
      Enabled: true
      Line Style: Lines
      Name: Grid
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 42; 42; 46
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 22
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
      X: -0.5
      Y: 1.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: true
  Width: 1400
  X: 40
  Y: 40
