# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Maps / bags / logs (local run products, don't commit)
*.pgm
# ...except the sample map shipped with the repo
!console/maps/*.pgm
!wall_task/maps/*.pgm
*.yaml.bak
*.bag
*.log

# Old local data storage stays in place after the source-only migration.
/bagtools/
/bagfiles/
/archive/
/wallmark/
/vendor/
/docs/manuals/
/docs/reference/
/tmp/

# RViz / rqt local state
*.rviz.bak

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local overrides (example only, never commit real IPs)
.config/
*.local

# Local notes / archived material (never published)
_local/

# Local agent workspace / scratch (not part of the project)
.workbuddy-ai/
.slidep/

# YOLO weights and training output (large binaries, regenerate from data)
*.pt
*.pth
*.onnx
*.weights
*.bag.active
*.part
paths.local.json
runs/

